# Concord Server Configuration

# Server network settings
host = "0.0.0.0"
port = 8080

# Server name (displayed in client)
server_name = "Concord Server"

# Database file path
database_path = "concord.db"

# Maximum concurrent connections
max_connections = 1000

# Enable debug logging
debug = false

# Message pruning configuration
[message_pruning]
enabled = true
interval_hours = 24  # Run pruning daily

# Grapevine — decentralized server discovery (opt-in)
[grapevine]
enabled = false
hub_url = "https://grapevine.concordchat.cc"  # Official hub; or point to your own concord-hub instance
description = "A place to chat."
category = ""   # e.g. "Gaming", "Technology", "Art", "Tabletop", "General"
tags = []       # e.g. ["friendly", "18+", "english"]
max_members = 1000
heartbeat_interval_seconds = 30

# public_host / public_port: your server's externally reachable address.
# Required when the bind host is 0.0.0.0 or a private IP.
# Example: public_host = "myserver.example.com"
public_host = ""
public_port = 0

# Auto-populated after first successful registration — do not edit manually.
# Hub→server signals are verified with an HMAC of the registration_secret.
# server_id = ""
# registration_secret = ""

# Outgoing email — optional. With it, new accounts confirm their email with a
# 6-character code and members can reset a forgotten password. Without it,
# accounts work as before; reset a password with
#   concord-server --reset-password someone@example.com
# Check the settings with: concord-server --test-mail you@example.com
# This file then holds a password: keep it readable only by the server.
# [mail]
# smtp_host = "smtp.gmail.com"
# smtp_port = 587               # blank/0: 587 for starttls, 465 for tls
# security = "starttls"         # "starttls", "tls" (port 465) or "none" (a local relay only)
# smtp_username = "you@gmail.com"
# smtp_password = "an app password"
# from = "Concord <you@gmail.com>"
# require_verification = true   # false: send reset codes only, never block sign-in
