# Concord Server Configuration

# Server network settings
host = "0.0.0.0"
port = 8080

# Server name (displayed in client)
server_name = "Concord Server"

# Database file path
database_path = "concord.db"

# Maximum concurrent connections (0: no limit)
max_connections = 1000

# Maximum connections from one address (default 20; -1: no limit). Loopback
# is never capped, since everyone on Tor arrives from 127.0.0.1.
# max_connections_per_ip = 20

# Enable debug logging
debug = false

# Message pruning configuration
[message_pruning]
enabled = true
interval_hours = 24  # Run pruning daily

# Grapevine — decentralized server discovery (opt-in)
[grapevine]
enabled = false
hub_url = "https://grapevine.concordchat.cc"  # Official hub; or point to your own concord-hub instance
description = "A place to chat."
category = ""   # e.g. "Gaming", "Technology", "Art", "Tabletop", "General"
tags = []       # e.g. ["friendly", "18+", "english"]
max_members = 1000
heartbeat_interval_seconds = 30

# public_host / public_port: your server's externally reachable address.
# Required when the bind host is 0.0.0.0 or a private IP.
# Example: public_host = "myserver.example.com"
public_host = ""
public_port = 0

# Auto-populated after first successful registration — do not edit manually.
# Hub→server signals are verified with an HMAC of the registration_secret.
# server_id = ""
# registration_secret = ""

# Outgoing email — optional. With it, new accounts confirm their email with a
# 6-character code and members can reset a forgotten password. Without it,
# accounts work as before; reset a password with
#   concord-server --reset-password someone@example.com
# Check the settings with: concord-server --test-mail you@example.com
# This file then holds a password: keep it readable only by the server.
# [mail]
# smtp_host = "smtp.gmail.com"
# smtp_port = 587               # blank/0: 587 for starttls, 465 for tls
# security = "starttls"         # "starttls", "tls" (port 465) or "none" (a local relay only)
# smtp_username = "you@gmail.com"
# smtp_password = "an app password"
# from = "Concord <you@gmail.com>"
# require_verification = true   # false: send reset codes only, never block sign-in

# Voice relays (optional). Voice is peer-to-peer: STUN (below, the default)
# connects most home networks directly, but two people behind strict routers
# (many offices, schools, mobile networks) need a TURN server to relay.
# Pick at most one way to configure TURN; with none, voice is STUN-only.
[voice]
# stun_urls = ["stun:stun.l.google.com:19302"]

# 1. Any TURN service with a fixed login:
# turn_urls     = ["turn:turn.example.com:3478", "turns:turn.example.com:5349"]
# turn_username = "concord"
# turn_password = "..."

# 2. Your own coturn with use-auth-secret (static-auth-secret = this value):
# turn_urls   = ["turn:turn.example.com:3478"]
# turn_secret = "..."

# 3. Cloudflare's TURN service (dashboard: Realtime > TURN > create a key;
#    works wherever this server runs; 1,000 GB/month free at the time of writing):
# cloudflare_turn_key_id = "..."
# cloudflare_turn_token  = "..."

# Backups (encrypted). The server backs itself up into backups/ beside the
# database: one file per backup, holding the database, this settings file,
# plugin-secrets.key and the plugins' data, encrypted with the backup key
# (backup.key beside the database, made with the first backup). The newest
# ten are kept. Keep a copy of the key somewhere safe: without it backups
# can't be read. `concord-server --backup-key` prints it, administrators see
# it in Server Settings > About (K), and
# `concord-server --open-backup <file> [--to <folder>] [--key <key file>]`
# unpacks a backup (so does `age -d -i backup.key <file> | tar xz`).
[backups]
every_hours = 24   # 0: only when an administrator presses B in Server Settings > About

# The database, encrypted at rest. A new database is encrypted with a random
# key in a key file; an existing unencrypted one keeps working until you
# convert it: stop the server, run `concord-server --encrypt-database`, and
# start it again (--decrypt-database turns it back). Keep a copy of the key
# somewhere safe: without it the database can't be read.
#
# A key file on the same machine protects a copied data folder or disk, not
# a seized running server; for that, ask_passphrase = true has you type a
# passphrase at every start (the server then can't restart by itself:
# reboots, crashes and updates wait for you).
[database]
# encrypt = true          # new databases only; false makes them unencrypted
# key_file = "/somewhere/else/concord-database.key"   # default: beside this file
#                         # (the CONCORD_DATABASE_KEY_FILE environment variable wins)
# ask_passphrase = false

# Tor (since v0.2.0): give the server a .onion address. The server runs the
# tor program installed on this machine (apt/dnf/pacman/brew install tor;
# the Docker image has it), with its own settings in tor/ beside the
# database. That folder holds the onion address's key and the access keys:
# backups carry them, and whoever has them can pose as the server.
#
# With client_auth (the default), the address is useless without the access
# key that invites carry (host.onion:port/CODE#KEY), so nobody can find or
# probe the server by learning its address. Members get the key when they
# sign in. If an invite leaks, Server Settings › About › T (twice) makes a
# new key; the old one keeps working for a week while members pick it up.
#
# only = true listens on 127.0.0.1 alone: the server can be reached through
# Tor and nothing else (in Docker, also remove the ports: mapping). An onion
# server isn't listed on Grapevine unless grapevine = true, which lists its
# normal address (never the onion one, and never with only).
[tor]
enabled = false
# only = false
# client_auth = true
# grapevine = false
# tor_path = "/usr/bin/tor"   # default: found on the PATH
