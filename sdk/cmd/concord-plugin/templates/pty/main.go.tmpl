// <%.Name%>: shows a terminal program in Concord channels. Everyone viewing
// sees the program; the first viewer has the keyboard (then the next, when
// they leave).
//
// Set program below to the binary you ship in the release zip, next to this
// plugin's own. Anyone holding the keyboard controls it, with this plugin's
// permissions on the server: never wrap a shell or anything that can start one.
package main

import (
	"context"
	"errors"
	"fmt"
	"log"
	"os"
	"os/signal"
	"path/filepath"

	"github.com/JMThomas00/Concord/sdk/plugin"
	"github.com/JMThomas00/Concord/sdk/pty"
)

// program is the terminal app to show, relative to this plugin's folder.
const program = "top"

func main() {
	cfg, underConcord := plugin.ConfigFromEnv()
	if !underConcord {
		fmt.Println("<%.Name%> runs " + program + " inside Concord channels; launch it from a Concord server.")
		return
	}
	command := program
	if exe, err := os.Executable(); err == nil {
		if local := filepath.Join(filepath.Dir(exe), program); fileExists(local) {
			command = local // prefer the copy shipped with the plugin
		}
	}
	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt)
	defer stop()
	err := plugin.Run(ctx, cfg, pty.Handler(pty.Options{Command: command}))
	if err != nil && !errors.Is(err, context.Canceled) {
		log.Fatal(err)
	}
}

func fileExists(p string) bool {
	st, err := os.Stat(p)
	return err == nil && !st.IsDir()
}
